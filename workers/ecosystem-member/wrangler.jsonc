{
  // One invocation per ecosystem member: does THIS business's own knowledge
  // answer a visitor's question another business's bot could not? (see src/index.ts)
  "name": "ecosystem-member",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // nodejs_compat populates process.env from vars/secrets, so the server's own
  // Jev client (src/llm/jev.ts) runs here unchanged.
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "whisp-vectors-m3" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "whisp-data" }],
  "vars": { "ANSWER_MODEL": "@cf/nvidia/nemotron-3-120b-a12b" },
  // Secrets: MEMBER_KEY (shared with the server), JEV_API_KEY.
  "observability": { "enabled": true }
}
